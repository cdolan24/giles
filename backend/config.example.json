{
  "libraries": [
    {
      "name": "UC Library",
      "type": "rest",
      "baseUrl": "https://uclibrary.example.edu/api",
      "apiKeyEnv": "API_KEY_UC_LIBRARY",
      "enabled": false,
      "backupScraper": "uc_library_scraper"
    },
    {
      "name": "arXiv",
      "type": "arxiv",
      "baseUrl": "https://export.arxiv.org/api/query",
      "enabled": true,
      "backupScraper": "arxiv_scraper"
    }
  ]
}
