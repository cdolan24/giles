{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["rest", "arxiv"], "default": "rest" },
          "baseUrl": { "type": "string" },
          "apiKeyEnv": { "type": "string", "description": "Environment variable holding the API key (preferred)" },
          "apiKey": { "type": "string", "description": "Inline API key; only use in an untracked config.json" },
          "enabled": { "type": "boolean" },
          "backupScraper": { "type": "string", "enum": ["arxiv_scraper", "uc_library_scraper"] }
        },
        "required": ["name", "baseUrl", "enabled"]
      }
    }
  },
  "required": ["libraries"]
}
